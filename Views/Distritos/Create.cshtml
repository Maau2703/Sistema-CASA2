@model Proyecto.Models.Distritos
@{ ViewData["Title"] = "Nuevo Distrito"; Layout = "_Layout"; }
<header class="casa-hero casa-hero--page"><div class="container"><h1>Nuevo Distrito</h1></div></header>
<div class="container casa-overlap">
  <div class="casa-form-card" style="max-width:700px;margin:0 auto;">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3"><label class="form-label">Nombre *</label><input type="text" name="nombre" class="form-control" required></div>
      <div class="mb-3"><label class="form-label">Color de cinta</label><input type="text" name="ColorCinta" class="form-control" placeholder="Ej: #FF7A00"></div>
      <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-casa btn-casa-lg">💾 Guardar</button><a class="btn btn-casa-ghost btn-casa btn-casa-lg" href="/Distritos">Cancelar</a></div>
    </form>
  </div>
</div>