@model Proyecto.Models.Mascotas
@{
    ViewData["Title"] = "Editar Mascota";
    ViewData["Page"] = "mascotas";
    Layout = "_Layout";
    var distritos = ViewBag.Distritos as List<Proyecto.Models.Distritos> ?? new List<Proyecto.Models.Distritos>();
}

<header class="casa-hero casa-hero--page">
  <div class="container">
    <h1>Editar mascota</h1>
    <p>Actualiza la información de @Model.Nombre</p>
  </div>
</header>

<div class="container casa-overlap">
  <div class="casa-form-card" style="max-width: 700px; margin: 0 auto;">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      <input type="hidden" name="Id" value="@Model.Id" />
      
      <div class="mb-3">
        <label class="form-label">Nombre *</label>
        <input type="text" name="Nombre" class="form-control" required value="@Model.Nombre">
      </div>

      <!-- NUEVO: Campo para cambiar el Estado -->
      <div class="mb-3">
        <label class="form-label">Estado de la mascota *</label>
        <select name="Estado" class="form-select" required>
            <option value="En adopción" selected="@(Model.Estado == "En adopción")">🏠 En adopción</option>
            <option value="Adoptado" selected="@(Model.Estado == "Adoptado")">✅ Adoptado</option>
            <option value="En rescate" selected="@(Model.Estado == "En rescate")">🚑 En rescate</option>
            <option value="No disponible" selected="@(Model.Estado == "No disponible")">❌ No disponible</option>
        </select>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Especie *</label>
          <select name="Especie" class="form-select" required>
            <option value="Perro" selected="@(Model.Especie == "Perro")">Perro</option>
            <option value="Gato" selected="@(Model.Especie == "Gato")">Gato</option>
            <option value="Conejo" selected="@(Model.Especie == "Conejo")">Conejo</option>
            <option value="Ave" selected="@(Model.Especie == "Ave")">Ave</option>
            <option value="Otro" selected="@(Model.Especie == "Otro")">Otro</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Edad aproximada *</label>
          <input type="text" name="Edad" class="form-control" required value="@Model.Edad">
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Tamaño *</label>
          <select name="Tamaño" class="form-select" required>
            <option value="Pequeño" selected="@(Model.Tamaño == "Pequeño")">Pequeño</option>
            <option value="Mediano" selected="@(Model.Tamaño == "Mediano")">Mediano</option>
            <option value="Grande" selected="@(Model.Tamaño == "Grande")">Grande</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Color *</label>
          <input type="text" name="Color" class="form-control" required value="@Model.Color">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Características / Descripción</label>
        <textarea name="Caracteristica" class="form-control" rows="3">@Model.Caracteristica</textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Foto actual</label>
        @if (!string.IsNullOrEmpty(Model.Foto)) {
            <div class="mb-2"><img src="@Model.Foto" alt="Foto" style="max-width: 200px; border-radius: 8px;"></div>
        }
        <label class="form-label">Subir nueva foto (opcional)</label>
        <input type="file" name="fotoFile" class="form-control" accept="image/*">
      </div>

      <div class="mb-3">
        <label class="form-label">Distrito *</label>
        <select name="DistritoId" class="form-select" required>
          <option value="">Selecciona...</option>
          @foreach (var d in distritos) {
            <option value="@d.Id" selected="@(Model.DistritoId == d.Id)">@d.nombre</option>
          }
        </select>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-casa btn-casa-lg">💾 Guardar cambios</button>
        <a class="btn btn-casa-ghost btn-casa btn-casa-lg" href="/Mascotas">Cancelar</a>
      </div>
    </form>
  </div>
</div>