@model Proyecto.Models.Mascotas
@{
    ViewData["Title"] = "Registrar Mascota";
    ViewData["Page"] = "mascotas";
    Layout = "_Layout";
    var distritos = ViewBag.Distritos as List<Proyecto.Models.Distritos> ?? new List<Proyecto.Models.Distritos>();
}

<header class="casa-hero casa-hero--page">
  <div class="container">
    <h1>Registrar nueva mascota</h1>
    <p>Completa la información del animal rescatado para ponerlo en adopción.</p>
  </div>
</header>

<div class="container casa-overlap">
  <div class="casa-form-card" style="max-width: 700px; margin: 0 auto;">
    <h2 class="mb-4">Datos de la mascota</h2>
    
    @if (!ViewData.ModelState.IsValid) {
        <div class="alert alert-danger mb-4">
            <h5 class="alert-heading">Por favor corrige los siguientes errores:</h5>
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      
      <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre *</label>
        <input asp-for="Nombre" name="Nombre" class="form-control" required>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label asp-for="Especie" class="form-label">Especie *</label>
          <select asp-for="Especie" name="Especie" class="form-select" required>
            <option value="">Selecciona...</option>
            <option>Perro</option>
            <option>Gato</option>
            <option>Conejo</option>
            <option>Ave</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="col-md-6">
          <label asp-for="Edad" class="form-label">Edad aproximada *</label>
          <input asp-for="Edad" name="Edad" class="form-control" placeholder="Ej: 2 años, Cachorro" required>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label asp-for="Tamaño" class="form-label">Tamaño *</label>
          <select asp-for="Tamaño" name="Tamaño" class="form-select" required>
            <option value="">Selecciona...</option>
            <option>Pequeño</option>
            <option>Mediano</option>
            <option>Grande</option>
          </select>
        </div>
        <div class="col-md-6">
          <label asp-for="Color" class="form-label">Color *</label>
          <input asp-for="Color" name="Color" class="form-control" required>
        </div>
      </div>

      <div class="mb-3">
        <label asp-for="Caracteristica" class="form-label">Características / Descripción</label>
        <textarea asp-for="Caracteristica" name="Caracteristica" class="form-control" rows="3"></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Foto de la mascota</label>
        <input type="file" name="fotoFile" class="form-control" accept="image/*">
        <div class="form-text">Sube una foto (JPG, PNG, máx 5MB)</div>
      </div>

      <div class="mb-3">
        <label asp-for="DistritoId" class="form-label">Distrito *</label>
        <select asp-for="DistritoId" name="DistritoId" class="form-select" required>
          <option value="">Selecciona un distrito...</option>
          @foreach (var d in distritos) {
            <option value="@d.Id">@d.nombre</option>
          }
        </select>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-casa btn-casa-lg">💾 Registrar mascota</button>
        <a class="btn btn-casa-ghost btn-casa btn-casa-lg" href="/Mascotas">Cancelar</a>
      </div>
    </form>
  </div>
</div>