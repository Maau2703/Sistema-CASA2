<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] · Proyecto C.A.S.A.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link href="~/css/styles.css" rel="stylesheet">
</head>
<body data-page="@ViewData["Page"]">
  
  <nav class="navbar navbar-expand-lg casa-nav sticky-top" aria-label="Navegación principal">
    <div class="container">
      <a class="casa-brand" href="/" aria-label="Proyecto C.A.S.A., inicio">
        <span class="casa-brand__logo" aria-hidden="true">🐾</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#casaMenu"
              aria-controls="casaMenu" aria-expanded="false" aria-label="Abrir menú">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="casaMenu">
        <ul class="navbar-nav align-items-lg-center gap-lg-1 pt-3 pt-lg-0">
          <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link" href="/Mascotas">Mascotas</a></li>
          <li class="nav-item d-none" id="menu-reportes"><a class="nav-link" href="/Reportes">Reportes</a></li>
          <li class="nav-item d-none" id="menu-adopciones"><a class="nav-link" href="/Adopciones">Adopciones</a></li>
          <li class="nav-item d-none" id="menu-mapa"><a class="nav-link" href="/Mapa">Mapa</a></li>
          <li class="nav-item d-none" id="menu-veterinarias"><a class="nav-link" href="/Establecimientos">Veterinarias</a></li>
          <li class="nav-item d-none" id="menu-admin">
          <li class="nav-item ms-3" id="auth-buttons"></li>
        </ul>
      </div>
    </div>
  </nav>

  <main id="contenido" class="casa-main">
    @RenderBody()
  </main>

  <footer class="casa-footer mt-5">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-3">
      <div>
        <a class="casa-brand" href="/">
          <span class="casa-brand__logo" aria-hidden="true">🐾</span>
          <span>C.A.S.A.</span>
        </a>
        <p class="mt-2 mb-0 small">Centro de Alerta, Salvamento y Adopción.<br>Sucre, Chuquisaca · Bolivia</p>
      </div>
      <ul class="list-unstyled small mb-0">
        <li><a href="/Mascotas">Mascotas</a></li>
        <li><a href="/Reportes">Reportes</a></li>
        <li><a href="/Adopciones">Adopciones</a></li>
        <li><a href="/Establecimientos">Veterinarias y albergues</a></li>
        <li><a href="/Mapa">Mapa</a></li>
      </ul>
    </div>
  </footer>

  <!-- 1. Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  
  <!-- 2. SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- 3. Función confirmarAccion MEJORADA CON LOGS DETALLADOS -->
  <script>
    window.confirmarAccion = function(mensaje, urlDestino, formElement) {
      Swal.fire({
        title: '¿Estás seguro?',
        text: mensaje,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, continuar',
        cancelButtonText: 'Cancelar'
      }).then((result) => {
        if (result.isConfirmed) {
          if (formElement) {
            console.log('✅ CONFIRMADO: Ejecutando formElement.submit()');
            console.log('🎯 Action del formulario:', formElement.action);
            console.log('🎯 Method del formulario:', formElement.method);
            formElement.submit();
          } else if (urlDestino) {
            console.log('✅ Redirigiendo a:', urlDestino);
            window.location.href = urlDestino;
          }
        } else {
          console.log('❌ Acción cancelada por el usuario');
        }
      });
      return false; // Previene la acción por defecto del navegador
    };

    // Notificaciones automáticas desde TempData
    document.addEventListener('DOMContentLoaded', function() {
      const successMsg = '@TempData["Success"]';
      const errorMsg = '@TempData["Error"]';
      const warningMsg = '@TempData["Warning"]';

      if (successMsg) {
        Swal.fire({ icon: 'success', title: '¡Éxito!', text: successMsg, timer: 3000, showConfirmButton: false });
      }
      if (errorMsg) {
        Swal.fire({ icon: 'error', title: 'Error', text: errorMsg });
      }
      if (warningMsg) {
        Swal.fire({ icon: 'warning', title: 'Atención', text: warningMsg });
      }
    });
  </script>

  <!-- 4. Lógica de Autenticación -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const token = localStorage.getItem('casa.token');
        const userStr = localStorage.getItem('casa.user');
        let user = null;
        try { user = userStr ? JSON.parse(userStr) : null; } catch(e) {}

        const authContainer = document.getElementById('auth-buttons');
        const menuItems = {
          reportes: document.getElementById('menu-reportes'),
          adopciones: document.getElementById('menu-adopciones'),
          mapa: document.getElementById('menu-mapa'),
          veterinarias: document.getElementById('menu-veterinarias'),
          admin: document.getElementById('menu-admin')
        };

        if (token && user) {
          const rol = (user.rol || user.Rol || '').toLowerCase();
          const esAdmin = rol === 'administrador';
          const esRescatista = rol === 'rescatista';

          Object.values(menuItems).forEach(item => {
            if (item) item.classList.remove('d-none');
          });

          if (!esAdmin && menuItems.admin) {
            menuItems.admin.classList.add('d-none');
          }

          authContainer.innerHTML = `
            <div class="d-flex align-items-center gap-2">
              <span class="text-white fw-bold d-none d-lg-inline">Hola, ${user.nombre || 'Usuario'}</span>
              <button class="btn btn-casa-ghost btn-casa-sm" id="btn-logout" type="button">Salir</button>
            </div>
          `;

          document.getElementById('btn-logout').addEventListener('click', function() {
            localStorage.removeItem('casa.token');
            localStorage.removeItem('casa.user');
            window.location.href = '/';
          });

        } else {
          Object.values(menuItems).forEach(item => {
            if (item) item.classList.add('d-none');
          });

          authContainer.innerHTML = `
            <div class="d-flex gap-2">
              <a class="btn btn-casa-ghost btn-casa-sm" href="/Auth/Login">Iniciar Sesión</a>
              <a class="btn btn-casa btn-casa-sm" href="/Auth/Login#crear">Crear Cuenta</a>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error en autenticación:', error);
      }
    });
  </script>

  <!-- 5. Scripts comunes del proyecto -->
  <script src="~/js/common.js"></script>
  
  <!-- 6. Renderizado de secciones de scripts de las vistas -->
  @await RenderSectionAsync("Scripts", required: false)

</body>
</html>