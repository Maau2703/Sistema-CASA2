@{ 
    ViewData["Title"] = "Reportes de Animales"; 
    Layout = "_Layout"; 
    var reportes = ViewBag.Reportes as List<Proyecto.Models.Reportes>; 
}

<header class="casa-hero casa-hero--page">
    <div class="container">
        <h1>Reportes de Animales</h1>
        <p>¿Viste un animal perdido o abandonado? Cuéntanos.</p>
        <a class="btn btn-casa btn-casa-sm mt-3" href="/Reportes/Create">➕ Nuevo reporte</a>
    </div>
</header>

<div class="container casa-overlap">
    @if(TempData["Success"] != null) {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }
    
    <div class="row g-4 mt-2">
        @if(reportes != null && reportes.Any()) {
            @foreach(var r in reportes) {
                <div class="col-md-6 col-lg-4">
                    <div class="casa-card h-100">
                        <div class="casa-card__body">
                            @if(!string.IsNullOrEmpty(r.ImagenUrl)) {
                                <div class="mb-3 text-center">
                                    <img src="@r.ImagenUrl" alt="Foto del reporte" class="img-fluid rounded"
                                         style="max-height: 250px; object-fit: cover; width: 100%;"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                    <div class="alert alert-secondary" style="display:none;">📷 Sin imagen disponible</div>
                                </div>
                            } else {
                                <div class="mb-3 text-center">
                                    <div class="alert alert-secondary">📷 Sin imagen</div>
                                </div>
                            }
                            
                            <div class="d-flex justify-content-between mb-2">
                                <h5 class="mb-0 fw-bold">@r.TipoReporte?.nombre</h5>
                                <span class="badge bg-warning text-dark">@r.estado</span>
                            </div>
                            
                            <div class="mb-2"><small class="text-muted">📍 @r.Ubicaion</small></div>
                            <div class="mb-2"><small class="text-muted">📅 @r.Fecha.ToString("dd/MM/yyyy")</small></div>
                            <p class="small text-muted mb-3">@r.Descripcion</p>
                            
                            <!-- BOTONES DE ACCIÓN -->
                            <div class="d-flex gap-2 mt-3">
                                <a href="/Reportes/Edit/@r.Id" class="btn btn-primary btn-sm flex-grow-1">✏️ Actualizar estado</a>
                                <form asp-action="Delete" asp-controller="Reportes" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este reporte?');">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        } else {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">
                    <h4>No hay reportes registrados</h4>
                    <p class="mb-0">Sé el primero en reportar un animal que necesite ayuda.</p>
                </div>
            </div>
        }
    </div>
</div>