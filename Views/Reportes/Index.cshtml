@using Proyecto.Helpers; <!-- ✅ IMPORTANTE: Importar el Helper aquí -->

@{ 
    ViewData["Title"] = "Reportes de Animales"; 
    Layout = "_Layout"; 
    var reportes = ViewBag.Reportes as List<Proyecto.Models.Reportes>; 
    
    var esAdmin = ViewBag.EsAdmin as bool? ?? false;
    var esRescatista = ViewBag.EsRescatista as bool? ?? false;
    var ciudadanoIdActual = ViewBag.CiudadanoId as int?;
}

<header class="casa-hero casa-hero--page">
    <div class="container">
        <h1>Reportes de Animales</h1>
        <p>¿Viste un animal perdido o abandonado? Cuéntanos.</p>
        <a class="btn btn-casa btn-casa-sm mt-3" href="/Reportes/Create">➕ Nuevo reporte</a>
    </div>
</header>

<div class="container casa-overlap">
    @if(TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if(TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <div class="row g-4 mt-2">
        @if(reportes != null && reportes.Any()) {
            @foreach(var r in reportes) {
                
                // ✅ USO DEL HELPER EN LA VISTA: Código limpio y legible
                string rolParaHelper = esAdmin ? "Administrador" : (esRescatista ? "Rescatista" : null);
                bool puedeEditar = PermissionHelper.CanManageReport(rolParaHelper, ciudadanoIdActual, r.CiudadanoId);

                <div class="col-md-6 col-lg-4">
                    <div class="casa-card h-100">
                        <div class="casa-card__body">
                            @if(!string.IsNullOrEmpty(r.ImagenUrl)) {
                                <div class="mb-3 text-center">
                                    <img src="@r.ImagenUrl" alt="Foto del reporte" class="img-fluid rounded"
                                         style="max-height: 250px; object-fit: cover; width: 100%;"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                                    <div class="alert alert-secondary" style="display:none;">📷 Sin imagen disponible</div>
                                </div>
                            } else {
                                <div class="mb-3 text-center">
                                    <div class="alert alert-secondary">📷 Sin imagen</div>
                                </div>
                            }
                            
                            <div class="d-flex justify-content-between mb-2">
                                <h5 class="mb-0 fw-bold">@r.TipoReporte?.nombre</h5>
                                <span class="badge bg-warning text-dark">@r.estado</span>
                            </div>
                            
                            <div class="mb-2"><small class="text-muted">📍 @r.Ubicaion</small></div>
                            <div class="mb-2"><small class="text-muted">📅 @r.Fecha.ToString("dd/MM/yyyy")</small></div>
                            <p class="small text-muted mb-3">@r.Descripcion</p>

                            <!-- ✅ MOSTRAR COMENTARIO DE RESOLUCIÓN SI EXISTE -->
                            @if (!string.IsNullOrEmpty(r.ComentarioResolucion))
                            {
                                <div class="alert alert-success small mb-3 border-start border-4 border-success">
                                    <strong>📝 Nota de resolución:</strong><br>
                                    @r.ComentarioResolucion
                                </div>
                            }
                            
                            <!-- ✅ BOTONES DE ACCIÓN CON PERMISOS -->
                            <div class="d-flex gap-2 mt-3">
                                @if (puedeEditar)
                                {
                                    <a href="/Reportes/Edit/@r.Id" class="btn btn-primary btn-sm flex-grow-1">✏️ Actualizar estado</a>
                                }
                                
                                @if (esAdmin)
                                {
                                    <form asp-action="Delete" asp-controller="Reportes" method="post" class="d-inline" 
                                          onsubmit="return confirmarAccion('¿Estás seguro de eliminar este reporte permanentemente?', null, this);">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar reporte">🗑️</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        } else {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">
                    <h4>No hay reportes registrados</h4>
                    <p class="mb-0">Sé el primero en reportar un animal que necesite ayuda.</p>
                </div>
            </div>
        }
    </div>
</div>