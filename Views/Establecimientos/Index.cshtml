@{
    ViewData["Title"] = "Veterinarias y Albergues";
    ViewData["Page"] = "establecimientos";
    Layout = "_Layout";
    var items = ViewBag.Establecimientos as List<Proyecto.Models.Establecimientos> ?? new List<Proyecto.Models.Establecimientos>();
}

<header class="casa-hero casa-hero--page">
  <div class="container">
    <h1>Veterinarias y Albergues</h1>
    <p>Centros de atención y refugios registrados en el sistema.</p>
    <a class="btn btn-casa btn-casa-sm mt-3 d-none" id="btn-crear-establecimiento" href="/Establecimientos/Create">➕ Registrar nuevo establecimiento</a>
  </div>
</header>

<div class="container casa-overlap">
  @if (TempData["Success"] != null) {
    <div class="alert alert-success alert-dismissible fade show mt-3">
      @TempData["Success"]
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  }

  <div class="row g-4 mt-2">
    @foreach (var item in items) {
      <div class="col-md-6 col-lg-4">
        <div class="casa-card h-100">
          <div class="casa-card__body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="h5 mb-0">@item.nombre</h3>
              <span class="badge bg-@(item.estado == "Activo" ? "success" : "secondary")">@item.estado</span>
            </div>
            <p class="text-muted small mb-2">
              <strong>Tipo:</strong> @(item.TipoEstablecimiento?.nombre ?? "Sin tipo")<br>
              <strong>Distrito:</strong> @(item.Distritos?.nombre ?? "Sin distrito")
            </p>
            <p class="small mb-1">📍 @item.direccion</p>
            <p class="small mb-1">📞 @item.telefono</p>
            <p class="small mb-3"> @item.horario</p>
            
            <div class="d-flex gap-2 mt-auto d-none crud-buttons" data-id="@item.Id">
              <a href="/Establecimientos/Edit/@item.Id" class="btn btn-sm btn-outline-primary flex-grow-1 edit-btn">✏️ Editar</a>
              <form asp-action="Delete" method="post" class="d-inline delete-btn" 
                    onsubmit="return confirmarAccion('¿Eliminar este establecimiento permanentemente?', null, this);">
                <input type="hidden" name="id" value="@item.Id" />
                <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    }
    @if (!items.Any()) {
      <div class="col-12 text-center py-5">
        <p class="text-muted">No hay establecimientos registrados aún.</p>
        <a class="btn btn-casa btn-casa-sm mt-2 d-none" id="btn-crear-primero" href="/Establecimientos/Create">➕ Registrar el primero</a>
      </div>
    }
  </div>
</div>

@section Scripts {
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const userStr = localStorage.getItem('casa.user');
    let user = null;
    try { user = userStr ? JSON.parse(userStr) : null; } catch(e) {}

    const rol = (user?.rol || user?.Rol || '').toLowerCase();
    const esAdmin = rol === 'administrador';
    const esRescatista = rol === 'rescatista';
    const puedeEditar = esAdmin || esRescatista;

    if (puedeEditar) {
      const btnCrear = document.getElementById('btn-crear-establecimiento');
      const btnPrimero = document.getElementById('btn-crear-primero');
      if (btnCrear) btnCrear.classList.remove('d-none');
      if (btnPrimero) btnPrimero.classList.remove('d-none');
    }

    document.querySelectorAll('.crud-buttons').forEach(container => {
      const deleteBtn = container.querySelector('.delete-btn');
      if (esAdmin) {
        container.classList.remove('d-none');
      } else if (esRescatista) {
        container.classList.remove('d-none');
        if (deleteBtn) deleteBtn.remove();
      }
    });
  });
</script>
}