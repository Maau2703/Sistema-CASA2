@{
    ViewData["Title"] = "Panel de Gestión de Adopciones";
    Layout = "_Layout";
    var solicitudesPorMascota = ViewBag.SolicitudesPorMascota as List<dynamic>;
    var total = ViewBag.TotalSolicitudes as int? ?? 0;
    var pendientes = ViewBag.Pendientes as int? ?? 0;
}

<header class="casa-hero casa-hero--page bg-primary text-white">
    <div class="container">
        <h1>📋 Panel de Gestión de Adopciones</h1>
        <p>Visualiza todos los interesados en cada mascota y gestiona las aprobaciones.</p>
        <a class="btn btn-light btn-sm mt-2" href="/Adopciones">← Volver a mis solicitudes</a>
    </div>
</header>

<div class="container casa-overlap">
    @if (TempData["Success"] != null) { <div class="alert alert-success mt-3">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger mt-3">@TempData["Error"]</div> }

    <!-- ESTADÍSTICAS RÁPIDAS -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body text-center">
                    <h3 class="mb-0 text-primary">@total</h3>
                    <small class="text-muted">Total de postulaciones</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-warning border-0 shadow-sm">
                <div class="card-body text-center">
                    <h3 class="mb-0 text-dark">@pendientes</h3>
                    <small class="text-muted">Solicitudes Pendientes de revisión</small>
                </div>
            </div>
        </div>
    </div>

    @if (solicitudesPorMascota != null && solicitudesPorMascota.Any())
    {
        foreach (var grupo in solicitudesPorMascota)
        {
            var mascota = grupo.Mascota;
            var solicitudes = grupo.Solicitudes as List<Proyecto.Models.SolicitudesAdopcion>;

            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold">🐾 @mascota?.Nombre</h5>
                        <small class="text-muted">@mascota?.Especie | @mascota?.Edad | @mascota?.Color</small>
                    </div>
                    <span class="badge bg-primary fs-6">@solicitudes.Count interesado(s)</span>
                </div>
                
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Postulante</th>
                                    <th>Contacto</th>
                                    <th>Barrio</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in solicitudes)
                                {
                                    var ciudadano = s.Ciudadanos;
                                    var usuario = ciudadano?.usuarios;

                                    var badgeClass = s.Estado switch {
                                        "Pendiente" => "bg-warning text-dark",
                                        "Aprobada" => "bg-success",
                                        "Rechazada" => "bg-danger",
                                        "En proceso" => "bg-info text-dark",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td>
                                            <strong>@(usuario?.nombre ?? "Desconocido")</strong><br>
                                            <small class="text-muted">CI: @(usuario?.ci ?? "N/A")</small>
                                        </td>
                                        <td>
                                            <small>📧 @(usuario?.Email ?? "N/A")<br>📱 @(usuario?.celular ?? "N/A")</small>
                                        </td>
                                        <td>@(ciudadano?.barrio ?? "N/A")</td>
                                        <td><small>@s.fecha.ToString("dd/MM/yyyy")</small></td>
                                        <td><span class="badge @badgeClass">@s.Estado</span></td>
                                        <td class="text-end">
                                            @if (s.Estado == "Pendiente")
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <input type="hidden" name="nuevoEstado" value="Aprobada" />
                                                        <button type="submit" class="btn btn-success" title="Aprobar" onclick="return confirm('¿Aprobar? La mascota se marcará como Adoptada.');">✅</button>
                                                    </form>
                                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@s.Id" />
                                                        <input type="hidden" name="nuevoEstado" value="Rechazada" />
                                                        <button type="submit" class="btn btn-danger" title="Rechazar" onclick="return confirm('¿Rechazar esta solicitud?');">❌</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <select name="nuevoEstado" class="form-select form-select-sm" onchange="this.form.submit()" style="width: 130px;">
                                                        <option value="Pendiente" selected="@(s.Estado == "Pendiente")">Pendiente</option>
                                                        <option value="En proceso" selected="@(s.Estado == "En proceso")">En proceso</option>
                                                        <option value="Aprobada" selected="@(s.Estado == "Aprobada")">Aprobada</option>
                                                        <option value="Rechazada" selected="@(s.Estado == "Rechazada")">Rechazada</option>
                                                    </select>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>No hay solicitudes registradas en el sistema</h4>
        </div>
    }
</div>