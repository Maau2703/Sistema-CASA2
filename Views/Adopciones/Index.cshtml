@{
    ViewData["Title"] = "Mis Solicitudes de Adopción";
    Layout = "_Layout";
    var solicitudes = ViewBag.Solicitudes as List<Proyecto.Models.SolicitudesAdopcion> ?? new List<Proyecto.Models.SolicitudesAdopcion>();
    var esAdmin = ViewBag.EsAdmin as bool? ?? false;
    var esRescatista = ViewBag.EsRescatista as bool? ?? false;
}

<header class="casa-hero casa-hero--page">
    <div class="container">
        <h1>Mis Solicitudes de Adopción</h1>
        <p>Revisa el estado de tus postulaciones.</p>
        <div class="d-flex gap-2 mt-3">
            <a class="btn btn-casa btn-casa-sm" href="/Mascotas">🐾 Buscar mascotas</a>
            
            @if (ViewBag.EsAdmin == true || ViewBag.EsRescatista == true)
            {
                <a class="btn btn-warning btn-casa-sm text-dark fw-bold border-0" href="/Adopciones/Solicitudes" style="background-color: #FF7A00;">
                     PANEL ADMIN: Ver TODAS las solicitudes
                </a>
            }
        </div>
    </div>
</header>

<div class="container casa-overlap">
    @if (TempData["Success"] != null) { <div class="alert alert-success mt-3">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger mt-3">@TempData["Error"]</div> }
    @if (TempData["Warning"] != null) { <div class="alert alert-warning mt-3">@TempData["Warning"]</div> }

    <div class="row g-4 mt-2">
        @if (solicitudes.Any())
        {
            foreach (var s in solicitudes)
            {
                var ciudadano = s.Ciudadanos;
                var usuario = ciudadano?.usuarios;
                var mascota = s.Mascotas;

                var badgeClass = s.Estado switch {
                    "Pendiente" => "bg-warning text-dark",
                    "Aprobada" => "bg-success",
                    "Rechazada" => "bg-danger",
                    "En proceso" => "bg-info text-dark",
                    _ => "bg-secondary"
                };

                <div class="col-md-6 col-lg-4">
                    <div class="casa-card h-100">
                        <div class="casa-card__body">
                            @if (!string.IsNullOrEmpty(mascota?.Foto)) {
                                <img src="@mascota.Foto" class="img-fluid rounded mb-3" style="max-height: 200px; width: 100%; object-fit: cover;">
                            }

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="mb-0 fw-bold">🐾 @mascota?.Nombre</h5>
                                <span class="badge @badgeClass">@s.Estado</span>
                            </div>
                            <p class="small text-muted mb-2">@mascota?.Especie | @mascota?.Edad</p>
                            <hr>
                            
                            <p class="small text-muted mb-3">📅 Postulado el: @s.fecha.ToString("dd/MM/yyyy")</p>

                            <!-- CIUDADANO: Puede cancelar su solicitud si está pendiente -->
                            @if (!esAdmin && !esRescatista && s.Estado == "Pendiente")
                            {
                                <form asp-action="Delete" method="post" 
                                      onsubmit="return confirmarAccion('¿Cancelar tu solicitud de adopción?', null, this);">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">❌ Cancelar mi solicitud</button>
                                </form>
                            }

                            <!-- ADMIN: Puede eliminar desde aquí también -->
                            @if (esAdmin)
                            {
                                <form asp-action="Delete" method="post" class="mt-2" 
                                      onsubmit="return confirmarAccion('¿Eliminar permanentemente esta solicitud?', null, this);">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">️ Eliminar</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">
                    <h4>No tienes solicitudes activas</h4>
                    <p class="mb-0">¡Ve a la sección de mascotas y postúlate para adoptar!</p>
                </div>
            </div>
        }
    </div>
</div>